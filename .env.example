# ── API Keys ─────────────────────────────────────────────────────
BIRDEYE_API_KEY=                   # B-05 级别, 支持 WebSocket 实时价格推送

# ── Helius (Business 级别) ───────────────────────────────────────
# Enhanced WebSocket (链上交易监听 — 必须配置)
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Gatekeeper Beta (WebSocket 最低延迟, 同时也用于 RPC 发单)
HELIUS_GATEKEEPER_URL=https://beta.helius-rpc.com/?api-key=YOUR_KEY
# 标准 RPC (兜底)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=

# WebSocket 订阅模式
#   "multi" = ★推荐★ 所有 mint 合并成一个 transactionSubscribe, 只占 1 个订阅 slot
#   "token" = 每 mint 一个独立订阅. credits 最省, 但多订阅可能丢单 (不推荐)
#   "pump"  = 一个 accountInclude:[PumpAMM] 全局订阅
#   "auto"  = 代币数 ≤ HELIUS_TOKEN_LIMIT 用 token, 超过自动切 pump
HELIUS_SUB_MODE=multi
HELIUS_TOKEN_LIMIT=50
HELIUS_MULTI_DEBOUNCE_MS=500
HELIUS_MAX_MINTS_PER_SUB=50

# ── Jupiter ──────────────────────────────────────────────────────
JUPITER_API_URL=https://api.jup.ag
JUPITER_API_KEY=

# ── 钱包 ─────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=                # Base58 私钥 (DRY_RUN 模式下可留空)

# ── 交易参数 ──────────────────────────────────────────────────────
TRADE_SIZE_SOL=1
SLIPPAGE_BPS=500                   # 默认滑点 (bps)
SLIPPAGE_MAX_BPS=2000              # 最大滑点 (重试时递增)
TRADE_MAX_RETRY=3
PRIORITY_FEE_MICROLAMPORTS=100000

# ════════════════════════════════════════════════════════════════
# ★ V7 量能突破策略参数 (Volume Breakout)
# ════════════════════════════════════════════════════════════════
# 已删除的旧参数 (V6 及以前):
#   RSI_*, EMA_*, EMA_SLOPE_*, EMA_PRICE_FILTER_*
#   DROP_24H_*, HIGH24H_CACHE_MS
#   ADD_POSITION_*, MAX_HOLD_SEC, TIMEOUT_EXIT
#   TAKE_PROFIT_*, STOP_LOSS_*
#   VOL_DECAY_EXIT_*, VOL_BUY_MULT, VOL_SELL_MULT, VOL_WINDOW_SEC
#   MIN_CANDLES_FOR_SIGNAL, WS_RSI_PREV_STALE_MS, SL_POLL_PREV_STALE_MS

# ── K 线 / 轮询 ──────────────────────────────────────────────────
KLINE_INTERVAL_SEC=60              # ★ V7: 1 分钟 K 线 (原 5 分钟)
PRICE_POLL_SEC=1                   # 价格轮询间隔 (秒)
SL_POLL_SEC=30                     # 止损 / 量能卖出轮询间隔 (秒)
SKIP_FIRST_CANDLES=3               # 启动后跳过前 N 根 K 线 (等量能基线收敛)

# ── 买入条件 (AND, 三者全部满足) ────────────────────────────────
# ① 量能爆发: 当根 K 线 volume ≥ 过去 N 根均量 × VOL_SPIKE_MULT
VOL_SPIKE_MULT=5                   # 5× 爆发 (信号少, 但更可靠)
VOL_SPIKE_LOOKBACK=20              # 对比过去 20 根 K 线均量 (= 过去 20 分钟)
# ② 买盘主导: 同 1 分钟 buyVol / (buyVol + sellVol) ≥ 65%
BUY_DOMINANCE_PCT=65
# ③ 价格跟涨: 同 1 分钟 close 相对 open 涨幅 ≥ 5%
PRICE_MOMENTUM_PCT=5
# 最低绝对成交量门槛 (SOL) — 防止微量假突破
VOL_MIN_TOTAL=5

# ════════════════════════════════════════════════════════════════
# ★ V7.1 防陷阱过滤器 (5 层防御, 全部默认开启)
# 针对 memecoin 的 pump-and-dump / 单根插针 / 拉高出货等陷阱
# ════════════════════════════════════════════════════════════════

# L1 实体扎实: |close-open| / (high-low) ≥ MIN_BODY_RATIO
#   即"实体占整根 K 线 (含上下影) 的比例". 0.5 = 实体至少占 K 线一半
#   防止"高开高走收盘缩回"形态. 默认 0.5 较严, 隐含 L2 功能
L1_BODY_FILTER_ENABLED=true
MIN_BODY_RATIO=0.5

# L2 上影线检验: (high - max(open,close)) / |close-open| ≤ MAX_UPPER_WICK_RATIO
#   防止"插针" K 线 (实体小但上影巨长). 1.0 = 上影不能超过实体长度
#   注: L1 默认 0.5 时 L2 是冗余兜底; 调低 L1 (如 0.3) 时 L2 仍然能起作用
L2_UPPER_WICK_FILTER_ENABLED=true
MAX_UPPER_WICK_RATIO=1.0

# L3 跟根确认 ★ 防陷阱最有效的一层 ★
#   信号根本身不立即买, 等下一根 K 线收盘
#   下根要求: close > 信号根 close 且 close ≥ open (维持涨势, 非红柱)
#   代价: 慢一根 K 线进场, 但能挡掉 80% 单根诱多陷阱
#   关闭后退化为 V7 行为 (信号当根立即买)
L3_FOLLOWUP_CONFIRM_ENABLED=true
L3_FOLLOWUP_TIMEOUT_SEC=120        # pending 状态最大等待时间, 超时清除

# L4 累涨封顶: 信号根 close vs N 根前 close 累计涨幅 ≤ MAX_PRECEDING_RUNUP_PCT
#   防止追到"拉高出货"的中后段 (前面已经涨爆了再追高 = 接盘)
L4_RUNUP_FILTER_ENABLED=true
RUNUP_LOOKBACK_BARS=3              # 看前 3 根 (= 3 分钟前的 close)
MAX_PRECEDING_RUNUP_PCT=30         # 累涨 ≤ 30% 才允许买入

# L5 紧止损 (闪跌保护): 买入后 N 秒内跌破入场价 -P%, 立即平仓
#   兜底前 4 层都没挡住的陷阱. 真启动很少在第一分钟就 -5%, 误伤极少
L5_FAST_STOP_ENABLED=true
FAST_STOP_WINDOW_SEC=90            # 买入后 90 秒内有效
FAST_STOP_PCT=-5                   # 跌 5% 立卖

# ── 卖出条件 (任一触发即卖) ────────────────────────────────────
# ① 移动止损 (★ 用户保留)
TRAILING_STOP_ENABLED=true
TRAILING_STOP_ACTIVATE=30          # 涨 30% 后激活
TRAILING_STOP_PCT=-20              # 从峰值回撤 20% 平仓
# ② 卖压反转: 同 1 分钟 sellVol 占比 ≥ 60%
SELL_DOMINANCE_ENABLED=true
SELL_DOMINANCE_PCT=60
# ③ 量能衰竭: 连续 N 根 K 线 volume 都低于 SMA(LOOKBACK)
VOL_FADE_ENABLED=true
VOL_FADE_CONSECUTIVE=3             # 连续 3 根
VOL_FADE_LOOKBACK=10               # 对比 SMA(10)
# ④ 持仓超时 (秒)
HOLD_TIMEOUT_SEC=1800              # 1800s = 30 分钟 (匹配 memecoin 爆发期)

# ── 卖出冷却 (★ 用户保留) ──────────────────────────────────────
SELL_COOLDOWN_SEC=1800             # 卖出后冷却时间 (秒), 默认 30 分钟

# ── FDV / LP 监控 ────────────────────────────────────────────────
FDV_CACHE_MS=1800000               # 30 分钟缓存 (买入前 getFdvFresh 强制刷新)
FDV_EXIT_USD=30000                 # FDV 低于此值退出监控
LP_EXIT_USD=10000                  # LP 低于此值退出监控
MIN_FDV_USD=15000                  # Webhook 接入时最低 FDV 门槛
MIN_LP_USD=5000                    # Webhook 接入时最低 LP 门槛
MAX_MONITOR_TOKENS=95              # 最大监控代币数, 满时自动清理最不活跃的
OVERVIEW_PATROL_SEC=7200           # FDV / LP / Age 巡检间隔 (秒, 默认 2 小时)

# ── 实时 OHLCV 刷新 ──────────────────────────────────────────────
OHLCV_REALTIME_ENABLED=true        # 主轮询 K 线源用 Birdeye OHLCV API
OHLCV_REFRESH_SEC=60               # ★ V7: 改为 60 秒, 对齐 1 分钟 K 线
OHLCV_REALTIME_BARS=120            # 实时刷新拉的 K 线根数 (120 根 1min ≈ 2 小时)

# ── 历史 K 线拉取队列 (防 Birdeye 429) ───────────────────────────
HIST_BARS=150                      # 启动时拉取的历史 K 线根数
HIST_FETCH_GAP_MS=1200             # 每次请求间隔 (毫秒)
HIST_RETRY_MAX=5
HIST_RETRY_BASE_MS=5000

# ── Birdeye 请求失败抑制 ────────────────────────────────────────
PRICE_HTTP_CACHE_MS=60000
PRICE_FAIL_PERM_TTL_MS=300000      # 永久错误 (400/404) 静默 5 分钟
PRICE_FAIL_TEMP_TTL_MS=30000       # 临时错误 (429/5xx/超时) 静默 30 秒
PRICE_FAIL_LOG_GAP_MS=60000

# ── 空跑模式 ──────────────────────────────────────────────────────
DRY_RUN=true                       # true=不实际交易, 只记录信号和模拟盈亏
DRY_RUN_DATA_DIR=/root/sol-monitor-data

# ── 服务器 ────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info

# ── X (Twitter) Mentions 24h 计数 (可选) ─────────────────────
# 没有 X_BEARER_TOKEN 时模块整体禁用, 前端 X 提及 列显示 -
X_BEARER_TOKEN=
X_MENTIONS_INTERVAL_SEC=7200       # 刷新间隔 (秒), 默认 2 小时
X_MENTIONS_REQUEST_GAP_SEC=15
X_MENTIONS_TIMEOUT_MS=10000
